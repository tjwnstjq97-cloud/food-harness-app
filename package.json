{
  "name": "food-harness-expo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "expo:lint": "EXPO_NO_DOTENV=1 npx expo lint",
    "expo:atlas:android": "EXPO_NO_DOTENV=1 EXPO_ATLAS=true npx expo export --platform android",
    "typecheck": "tsc --noEmit",
    "validate": "python3 harness/validators/run_all.py",
    "validate:fail": "python3 harness/validators/test_fail_cases.py",
    "appflow:dry-run": "python3 harness/tests/app_flow_dry_run.py",
    "auth-cache:preflight": "python3 harness/tests/auth_cache_preflight.py",
    "check": "npm run typecheck && npm run validate && npm run validate:fail && npm run appflow:dry-run && npm run auth-cache:preflight",
    "deploy:fn": "supabase functions deploy search-restaurant --project-ref hvucxypkwezwquejhlzg --no-verify-jwt",
    "deploy:fn:reviews": "supabase functions deploy fetch-reviews --project-ref hvucxypkwezwquejhlzg --no-verify-jwt && supabase functions deploy summarize-reviews --project-ref hvucxypkwezwquejhlzg --no-verify-jwt",
    "deploy:fn:all": "npm run deploy:fn && npm run deploy:fn:reviews",
    "lint": "npm run expo:lint"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@mj-studio/react-native-naver-map": "^2.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.103.3",
    "@tanstack/react-query": "^5.99.0",
    "expo": "~54.0.34",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~10.0.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
